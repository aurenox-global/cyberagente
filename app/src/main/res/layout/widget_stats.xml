<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#0A100E">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3FE0A6"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:text="CYBERAGENT" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#4ADE80"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="SEGURO" />

    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#9AA8A2"
        android:textSize="11sp"
        android:text="0 alertas" />
</LinearLayout>

<resources>
    <!--
      Tema AppCompat puro (dark, estilo «soft dark + menta»). Se evita
      Theme.Material3 porque las actividades construyen la UI con widgets
      AppCompat y no necesitan Material Components: así no se inflan
      componentes Material que puedan reventar en runtime.
    -->
    <style name="Theme.CyberAgent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#070B0A</item>
        <item name="colorPrimary">#3FE0A6</item>
        <item name="colorPrimaryDark">#070B0A</item>
        <item name="colorAccent">#3FE0A6</item>
        <item name="android:textColorPrimary">#F2FBF7</item>
        <item name="android:textColorSecondary">#9AA8A2</item>
        <item name="android:textColorHint">#5E6C67</item>
        <item name="android:statusBarColor">#070B0A</item>
        <item name="android:navigationBarColor">#070B0A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
